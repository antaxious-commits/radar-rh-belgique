{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Radar RH Belgique single-topic report (all text in French)",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "slug", "date", "period", "intro", "sections", "sources"],
  "$defs": {
    "source_ids": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "priority": { "enum": ["RED", "AMBER", "GREEN"] }
  },
  "properties": {
    "title": { "type": "string", "description": "Header title, e.g. 'RH BELGIQUE | CONTRÔLE DE PAIE'" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Report type, e.g. payroll, deadlines, works-council, pay-transparency, deep-dive" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Date the report was produced" },
    "period": { "type": "string", "description": "French period label, e.g. 'Novembre et décembre 2026'" },
    "summary": { "type": "string", "description": "One-sentence French summary shown on the website" },
    "example": { "type": "boolean" },
    "intro": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading"],
        "properties": {
          "heading": { "type": "string" },
          "paragraphs": { "type": "array", "items": { "type": "string" } },
          "bullets": { "type": "array", "items": { "type": "string" } },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "body", "source_ids"],
              "properties": {
                "title": { "type": "string" },
                "priority": { "$ref": "#/$defs/priority" },
                "status": { "type": "string" },
                "body": { "type": "string" },
                "impact": { "type": "string" },
                "tags": { "type": "array", "items": { "type": "string" } },
                "source_ids": { "$ref": "#/$defs/source_ids" }
              }
            }
          },
          "table": {
            "type": "object",
            "additionalProperties": false,
            "required": ["columns", "rows"],
            "properties": {
              "columns": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["cells"],
                  "properties": {
                    "cells": { "type": "array", "items": { "type": "string" } },
                    "priority": { "$ref": "#/$defs/priority" },
                    "source_ids": { "$ref": "#/$defs/source_ids" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "publisher", "url"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "label": { "type": "string" },
          "publisher": { "type": "string" },
          "url": { "type": "string", "pattern": "^https?://" }
        }
      }
    }
  }
}
